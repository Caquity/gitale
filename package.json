{
  "name": "gitale",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "description": "Local, agent-agnostic Story Checkpoint Workspace",
  "repository": {
    "type": "git",
    "url": "https://github.com/Caquity/gitale.git"
  },
  "bugs": {
    "url": "https://github.com/Caquity/gitale/issues"
  },
  "homepage": "https://github.com/Caquity/gitale#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "schema",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gitale": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "format": "prettier --write src schema scripts skills README.md *.json *.js .github/**/*.yml",
    "format:check": "prettier --check src schema scripts skills README.md *.json *.js .github/**/*.yml"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
